# Copy to .env.local. Without these the app still runs: waitlist and AI tutor show an offline notice.
# These are separate from the main app's VITE_SUPABASE_* on purpose: physics prep uses its OWN Supabase
# project and must never connect to the live eengineer database. On Vercel, add these two to the
# eengineer-app project's Environment Variables once the physics Supabase project exists.
VITE_PHYSICS_SUPABASE_URL=https://YOUR_PHYSICS_PROJECT_REF.supabase.co
VITE_PHYSICS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
